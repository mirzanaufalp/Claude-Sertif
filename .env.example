# ============================================================
# SIM-K3 Mining - konfigurasi email reminder otomatis (H-90 hari)
# Salin file ini menjadi .env lalu isi kredensial SMTP.
# ============================================================

# Port backend API + cron
PORT=4000

# Kirim otomatis berapa hari sebelum expired (default 90)
REMINDER_DAYS=90

# Jadwal cron harian (format cron 5 field)
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=Asia/Jakarta

# Pengiriman otomatis tanpa klik admin:
# 1 = aktif (cek saat server start + tiap CHECK_INTERVAL_MINUTES), 0 = mati
AUTO_SEND=1
CHECK_INTERVAL_MINUTES=60

# 1 = tidak kirim email sungguhan, hasil disimpan sebagai .eml di server/data/outbox
# 0 = kirim lewat SMTP di bawah
DRY_RUN=1

# 1 = pakai SMTP uji Ethereal bila SMTP_HOST kosong (email bisa dibuka via link preview)
ETHEREAL=0

# ------------------------------------------------------------
# SMTP (contoh Gmail: butuh App Password, bukan password akun)
#   smtp.gmail.com / 587 / secure=false
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SIM-K3 Mining <no-reply@antam.co.id>
MAIL_REPLY_TO=hse@antam.co.id

# Link yang ditampilkan pada body email
APP_BASE_URL=http://localhost:5173

# Origin yang diizinkan mengakses API
CORS_ORIGIN=*
